PORT=4000

# Production: a PostgreSQL connection string (Render, Neon, Supabase and others all give you one).
# Leave empty for local development, which keeps data in server/data/app.db.
DATABASE_URL=

# Long random text used to sign login tokens. If empty, one is generated and stored in the database.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# The first super admin, created only when the database has no admins yet.
SEED_ADMIN_EMAIL=admin@accidentdetection.local
SEED_ADMIN_PASSWORD=change_this_password

# Optional: comma separated list of dashboard addresses allowed to call the API. Empty allows any.
ALLOWED_ORIGINS=

# Distance and drive time on the live board. An OSRM compatible service; "off" = straight line estimates only.
# Leave unset to use the free public demo server (no guarantee, keep use light).
#ROUTING_URL=https://router.project-osrm.org

# Multiplier on the routing engine's drive time (engines assume empty roads). Default 1.7. Range 1 to 5.
#ROUTE_TIME_FACTOR=1.7
